rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isSuperAdmin() {
      return signedIn()
        && userData().role == "superadmin";
    }

    function isAdmin() {
      return signedIn()
        && userData().role == "admin";
    }

    function isStudent() {
      return signedIn()
        && userData().role == "student";
    }


    // ==============================
    // USERS
    // ==============================

    match /users/{userId} {

      // Super Admin: full access
      allow read, write: if isSuperAdmin();

      // Every user can read own profile
      allow read: if signedIn()
        && request.auth.uid == userId;

      // Admin can read students belonging to that Admin
      allow read: if isAdmin()
        && resource.data.role == "student"
        && resource.data.adminId == request.auth.uid;

      // Client cannot directly create users
      allow create: if false;

      // Only Super Admin can update/delete users
      allow update, delete: if isSuperAdmin();
    }


    // ==============================
    // TASKS
    // ==============================

    match /tasks/{taskId} {

      // Super Admin
      allow read, write: if isSuperAdmin();

      // Admin can read own tasks
      allow read: if isAdmin()
        && resource.data.adminId == request.auth.uid;

      // Admin can create task for own account
      allow create: if isAdmin()
        && request.resource.data.adminId == request.auth.uid;

      // Admin can update own task
      allow update: if isAdmin()
        && resource.data.adminId == request.auth.uid
        && request.resource.data.adminId == request.auth.uid;

      // Admin can delete own task
      allow delete: if isAdmin()
        && resource.data.adminId == request.auth.uid;

      // Student can read own tasks
      allow read: if isStudent()
        && resource.data.studentId == request.auth.uid;

      // Student can update only progress fields
      allow update: if isStudent()
        && resource.data.studentId == request.auth.uid
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "status",
            "acceptedAt",
            "completedAt",
            "completionSeconds",
            "updatedAt"
          ]);
    }


    // ==============================
    // ASSIGNMENTS
    // ==============================

    match /assignments/{assignmentId} {

      // Super Admin
      allow read, write: if isSuperAdmin();

      // Admin can read own assignments
      allow read: if isAdmin()
        && resource.data.adminId == request.auth.uid;

      // Admin can create
      allow create: if isAdmin()
        && request.resource.data.adminId == request.auth.uid;

      // Admin can update
      allow update: if isAdmin()
        && resource.data.adminId == request.auth.uid
        && request.resource.data.adminId == request.auth.uid;

      // Admin can delete
      allow delete: if isAdmin()
        && resource.data.adminId == request.auth.uid;

      // Student can read own assignments
      allow read: if isStudent()
        && resource.data.studentId == request.auth.uid;

      // Student can submit assignment
      allow update: if isStudent()
        && resource.data.studentId == request.auth.uid
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "submitted",
            "submissionDate",
            "submittedLate"
          ]);
    }


    // ==============================
    // TESTS
    // ==============================

    match /tests/{testId} {

      // Super Admin
      allow read, write: if isSuperAdmin();

      // Admin can read own tests
      allow read: if isAdmin()
        && resource.data.adminId == request.auth.uid;

      // Admin can create
      allow create: if isAdmin()
        && request.resource.data.adminId == request.auth.uid;

      // Admin can update
      allow update: if isAdmin()
        && resource.data.adminId == request.auth.uid
        && request.resource.data.adminId == request.auth.uid;

      // Admin can delete
      allow delete: if isAdmin()
        && resource.data.adminId == request.auth.uid;

      // Student can read own tests
      allow read: if isStudent()
        && resource.data.studentId == request.auth.uid;
    }
  }
}
